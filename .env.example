# SmartDialer configuration.
# Copy to `.env` and edit. Every value below is validated at startup (src/config/index.ts);
# an invalid value fails the process immediately rather than degrading silently.

# ---------------------------------------------------------------------------
# SAFETY — read this section before changing anything.
# ---------------------------------------------------------------------------
# This prototype must never place a real call. `mock` and `unreliable-mock` are the only
# provider drivers that exist in the codebase; there is no real-telecom implementation to
# enable. Any other value fails startup.
PROVIDER_DRIVER=mock

# Explicit acknowledgement that this process only simulates telephony. Startup refuses to
# continue unless this is exactly `true` — it exists so a real deployment cannot happen by
# accident or by copying a stale .env.
SIMULATION_MODE=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/smartdialer.db

# ---------------------------------------------------------------------------
# Global safety ceilings — these bound every campaign. A campaign may configure
# lower limits, never higher; the safety engine treats these as authoritative.
# ---------------------------------------------------------------------------
GLOBAL_MAX_CONCURRENT_CALLS=50
GLOBAL_CALLS_PER_SECOND=20
PROVIDER_MAX_CONCURRENT_CALLS=40

# ---------------------------------------------------------------------------
# Dialer defaults
# ---------------------------------------------------------------------------
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_RETRY_INITIAL_DELAY_MS=1000
DEFAULT_RETRY_MAX_DELAY_MS=30000
DEFAULT_RETRY_MULTIPLIER=2

# How long the engine waits for a provider to report a terminal outcome before it declares
# the call timed out, releases the concurrency slot and frees the agent. Without this a
# provider that goes silent would leak a slot forever.
PROVIDER_TIMEOUT_MS=45000

# Ceiling on a connected conversation. Distinct from the setup timeout above: silence during
# a call is expected (nothing is emitted while two people talk), so a conversation must not be
# judged against the timeout that detects a provider going quiet during setup.
MAX_CALL_DURATION_MS=1800000

# A call the provider answered but which no agent could take within this window counts as
# abandoned. This is the number the abandon-rate safety control measures.
ABANDON_TIMEOUT_MS=2000

# Dialer tick interval in virtual milliseconds.
DIALER_TICK_INTERVAL_MS=250

# ---------------------------------------------------------------------------
# Predictive pacing
# ---------------------------------------------------------------------------
PREDICTIVE_PACING_MULTIPLIER=1.0
PREDICTIVE_TARGET_OCCUPANCY=0.85
PREDICTIVE_MIN_ANSWER_RATE=0.1
MAX_ABANDON_RATE=0.03

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------
# Virtual time advances SIMULATION_SPEED x faster than real time in the live dashboard.
SIMULATION_SPEED=10
# Root seed for reproducible runs. The same seed and config replays identically.
SIMULATION_SEED=12345
