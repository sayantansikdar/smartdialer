{
  "name": "smartdialer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SmartDialer — a runnable, testable prototype of a progressive/predictive outbound dialer. Mock telecom providers only; never places real calls.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --experimental-strip-types --env-file-if-exists=.env --watch src/index.ts",
    "dev:web": "vite",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project server tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:concurrency": "vitest run tests/concurrency",
    "test:failure": "vitest run tests/failure",
    "test:simulation": "vitest run tests/simulation",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env scripts/migrate.mjs",
    "db:reset": "node --experimental-strip-types --env-file-if-exists=.env scripts/reset-db.mjs",
    "seed": "node --experimental-strip-types --env-file-if-exists=.env scripts/seed.mjs",
    "scenario": "node --experimental-strip-types --env-file-if-exists=.env src/sim/scenario-cli.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:web": "vitest run --project web",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
